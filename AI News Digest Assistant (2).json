        "jsCode": "return items.filter(item => {\n  const text =\n    (item.json.title || '') + ' ' +\n    (item.json.contentSnippet || '');\n\n  const keywords = [\n    'ai',\n    'artificial intelligence',\n    'openai',\n    'gemini',\n    'anthropic',\n    'startup',\n    'funding',\n    'research',\n    'security',\n    'llm'\n  ];\n\n  return keywords.some(keyword =>\n    text.toLowerCase().includes(keyword)\n  );\n});"
